<model>
    <mount>//OPNsense/ParentalControl</mount>
    <version>1.0.7</version>
    <description>Parental control</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <tick_interval type="IntegerField">
                <Default>10</Default>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Choose an interval between 5 and 60 seconds.</ValidationMessage>
            </tick_interval>
            <activity_threshold type="IntegerField">
                <Default>60</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100000</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Enter a number (KB per minute).</ValidationMessage>
            </activity_threshold>
            <idle_grace type="IntegerField">
                <Default>3</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Choose 0 to 60 minutes.</ValidationMessage>
            </idle_grace>
            <blockpage type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </blockpage>
            <page_port type="IntegerField">
                <Default>8089</Default>
                <MinimumValue>1024</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Choose a port between 1024 and 65535.</ValidationMessage>
            </page_port>
            <dns_servers type="TextField">
                <Mask>/^([0-9a-fA-F:.]{2,45}(\s*,\s*[0-9a-fA-F:.]{2,45}){0,3})?$/</Mask>
                <ValidationMessage>Enter one or more IP addresses separated by commas (at most 4), or leave empty.</ValidationMessage>
            </dns_servers>
            <dns_enforce type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </dns_enforce>
            <dns_interfaces type="InterfaceField">
                <Multiple>Y</Multiple>
                <ValidationMessage>Select the interfaces the clients are connected to.</ValidationMessage>
            </dns_interfaces>
            <dns_block_encrypted type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </dns_block_encrypted>
            <request_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </request_enabled>
            <request_cooldown type="IntegerField">
                <Default>15</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>1440</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Choose 1 to 1440 minutes.</ValidationMessage>
            </request_cooldown>
            <ntfy_server type="TextField">
                <Default>https://ntfy.sh</Default>
                <Mask>/^(https?:\/\/[^\s\/]{1,255})?$/</Mask>
                <ValidationMessage>Enter a server such as https://ntfy.sh (without a path), or leave empty.</ValidationMessage>
            </ntfy_server>
            <ntfy_topic type="TextField">
                <Mask>/^[A-Za-z0-9_\-]{0,64}$/</Mask>
                <ValidationMessage>Use only letters, digits, _ and -.</ValidationMessage>
            </ntfy_topic>
            <ntfy_token type="TextField">
                <Mask>/^[A-Za-z0-9_\-]{0,128}$/</Mask>
                <ValidationMessage>Invalid token.</ValidationMessage>
            </ntfy_token>
            <webhook_url type="TextField">
                <Mask>/^(https?:\/\/\S{1,500})?$/</Mask>
                <ValidationMessage>Enter a valid http(s) URL, or leave empty.</ValidationMessage>
            </webhook_url>
            <gui_url type="TextField">
                <Mask>/^(https?:\/\/\S{1,500})?$/</Mask>
                <ValidationMessage>Enter a valid http(s) URL, or leave empty.</ValidationMessage>
            </gui_url>
            <filter_backend type="OptionField">
                <Default>none</Default>
                <Required>Y</Required>
                <OptionValues>
                    <none>None</none>
                    <adguard>AdGuard Home</adguard>
                    <pihole>Pi-hole (v6)</pihole>
                </OptionValues>
            </filter_backend>
            <backend_url type="TextField">
                <Mask>/^(https?:\/\/\S{1,300})?$/</Mask>
                <ValidationMessage>Enter a URL such as http://192.168.1.2:3000, or leave empty.</ValidationMessage>
            </backend_url>
            <backend_user type="TextField">
                <Mask>/^.{0,128}$/</Mask>
            </backend_user>
            <backend_password type="TextField">
                <Mask>/^.{0,256}$/</Mask>
            </backend_password>
            <backend_verify_tls type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </backend_verify_tls>
            <dns_group_mode type="OptionField">
                <Default>block</Default>
                <Required>Y</Required>
                <OptionValues>
                    <block>Block (recommended with profiles)</block>
                    <redirect>Redirect to the DNS server</redirect>
                </OptionValues>
            </dns_group_mode>
        </general>
        <groups>
            <group type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[\p{L}0-9 _.\-]{1,64}$/u</Mask>
                    <ValidationMessage>Use 1-64 characters: letters, digits, space, dot, dash or underscore.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>This group name already exists.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </name>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
                <profile type="ModelRelationField">
                    <Model>
                        <profiles>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>profiles.profile</items>
                            <display>name</display>
                        </profiles>
                    </Model>
                    <Required>N</Required>
                </profile>
            </group>
        </groups>
        <profiles>
            <profile type="ArrayField">
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[\p{L}0-9 _.\-]{1,64}$/u</Mask>
                    <ValidationMessage>Use 1-64 characters: letters, digits, space, dot, dash or underscore.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>This profile name already exists.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </name>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
                <safesearch type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </safesearch>
                <parental type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </parental>
                <categories type="OptionField">
                    <Multiple>Y</Multiple>
                    <OptionValues>
                        <social>Social media</social>
                        <messaging>Chat and messaging</messaging>
                        <games>Games</games>
                        <video>Video and streaming</video>
                        <dating>Dating</dating>
                    </OptionValues>
                </categories>
                <backend_groups type="TextField">
                    <Mask>/^([\p{L}0-9 _.\-]{1,64}(\s*,\s*[\p{L}0-9 _.\-]{1,64})*)?$/u</Mask>
                    <ValidationMessage>Enter group names separated by commas.</ValidationMessage>
                </backend_groups>
                <blocked_domains type="TextField">
                    <Mask>/^([A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?(\s*,\s*[A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?)*)?$/</Mask>
                    <ValidationMessage>Enter domain names separated by commas (for example example.com, other.org).</ValidationMessage>
                </blocked_domains>
                <allowed_domains type="TextField">
                    <Mask>/^([A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?(\s*,\s*[A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?)*)?$/</Mask>
                    <ValidationMessage>Enter domain names separated by commas (for example example.com, other.org).</ValidationMessage>
                </allowed_domains>
            </profile>
        </profiles>
        <devices>
            <device type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[\p{L}0-9 _.\-]{1,64}$/u</Mask>
                    <ValidationMessage>Use 1-64 characters: letters, digits, space, dot, dash or underscore.</ValidationMessage>
                </name>
                <mac type="MacAddressField">
                    <Required>Y</Required>
                    <ValidationMessage>Enter a valid MAC address (aa:bb:cc:dd:ee:ff).</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>This MAC address is already in a group. A device can only be in one group.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </mac>
                <group type="ModelRelationField">
                    <Model>
                        <groups>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>groups.group</items>
                            <display>name</display>
                        </groups>
                    </Model>
                    <Required>Y</Required>
                    <ValidationMessage>Choose a group.</ValidationMessage>
                </group>
            </device>
        </devices>
        <bedtimes>
            <bedtime type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <groups type="ModelRelationField">
                    <Model>
                        <groups>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>groups.group</items>
                            <display>name</display>
                        </groups>
                    </Model>
                    <Multiple>Y</Multiple>
                    <Required>Y</Required>
                    <ValidationMessage>Choose at least one group.</ValidationMessage>
                </groups>
                <days type="OptionField">
                    <Required>Y</Required>
                    <Multiple>Y</Multiple>
                    <OptionValues>
                        <mon>Monday</mon>
                        <tue>Tuesday</tue>
                        <wed>Wednesday</wed>
                        <thu>Thursday</thu>
                        <fri>Friday</fri>
                        <sat>Saturday</sat>
                        <sun>Sunday</sun>
                    </OptionValues>
                    <ValidationMessage>Choose at least one day.</ValidationMessage>
                </days>
                <start type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([01][0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Use the format HH:MM (24 hours).</ValidationMessage>
                </start>
                <end type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([01][0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Use the format HH:MM (24 hours).</ValidationMessage>
                </end>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
            </bedtime>
        </bedtimes>
        <budgets>
            <budget type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <groups type="ModelRelationField">
                    <Model>
                        <groups>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>groups.group</items>
                            <display>name</display>
                        </groups>
                    </Model>
                    <Multiple>Y</Multiple>
                    <Required>Y</Required>
                    <ValidationMessage>Choose at least one group.</ValidationMessage>
                </groups>
                <days type="OptionField">
                    <Required>Y</Required>
                    <Multiple>Y</Multiple>
                    <OptionValues>
                        <mon>Monday</mon>
                        <tue>Tuesday</tue>
                        <wed>Wednesday</wed>
                        <thu>Thursday</thu>
                        <fri>Friday</fri>
                        <sat>Saturday</sat>
                        <sun>Sunday</sun>
                    </OptionValues>
                    <ValidationMessage>Choose at least one day.</ValidationMessage>
                </days>
                <minutes type="IntegerField">
                    <Required>Y</Required>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1440</MaximumValue>
                    <ValidationMessage>Enter the number of minutes (0 to 1440).</ValidationMessage>
                </minutes>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
            </budget>
        </budgets>
    </items>
</model>
