<model>
    <mount>//OPNsense/ParentalControl</mount>
    <version>1.0.6</version>
    <description>Ouderlijk toezicht</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <tick_interval type="IntegerField">
                <Default>10</Default>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Kies een interval tussen 5 en 60 seconden.</ValidationMessage>
            </tick_interval>
            <activity_threshold type="IntegerField">
                <Default>60</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100000</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Vul een getal in (KB per minuut).</ValidationMessage>
            </activity_threshold>
            <idle_grace type="IntegerField">
                <Default>3</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Kies 0 tot 60 minuten.</ValidationMessage>
            </idle_grace>
            <blockpage type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </blockpage>
            <page_port type="IntegerField">
                <Default>8089</Default>
                <MinimumValue>1024</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Kies een poort tussen 1024 en 65535.</ValidationMessage>
            </page_port>
            <dns_servers type="TextField">
                <Mask>/^([0-9a-fA-F:.]{2,45}(\s*,\s*[0-9a-fA-F:.]{2,45}){0,3})?$/</Mask>
                <ValidationMessage>Vul een of meer IP-adressen in, gescheiden door komma's (maximaal 4), of laat leeg.</ValidationMessage>
            </dns_servers>
            <dns_enforce type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </dns_enforce>
            <dns_interfaces type="InterfaceField">
                <Multiple>Y</Multiple>
                <ValidationMessage>Kies de interfaces waarop de clients zitten.</ValidationMessage>
            </dns_interfaces>
            <dns_block_encrypted type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </dns_block_encrypted>
            <request_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </request_enabled>
            <request_cooldown type="IntegerField">
                <Default>15</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>1440</MaximumValue>
                <Required>Y</Required>
                <ValidationMessage>Kies 1 tot 1440 minuten.</ValidationMessage>
            </request_cooldown>
            <ntfy_server type="TextField">
                <Default>https://ntfy.sh</Default>
                <Mask>/^(https?:\/\/[^\s\/]{1,255})?$/</Mask>
                <ValidationMessage>Vul een server in zoals https://ntfy.sh (zonder pad), of laat leeg.</ValidationMessage>
            </ntfy_server>
            <ntfy_topic type="TextField">
                <Mask>/^[A-Za-z0-9_\-]{0,64}$/</Mask>
                <ValidationMessage>Gebruik alleen letters, cijfers, _ en -.</ValidationMessage>
            </ntfy_topic>
            <ntfy_token type="TextField">
                <Mask>/^[A-Za-z0-9_\-]{0,128}$/</Mask>
                <ValidationMessage>Ongeldig token.</ValidationMessage>
            </ntfy_token>
            <webhook_url type="TextField">
                <Mask>/^(https?:\/\/\S{1,500})?$/</Mask>
                <ValidationMessage>Vul een geldige http(s)-URL in, of laat leeg.</ValidationMessage>
            </webhook_url>
            <gui_url type="TextField">
                <Mask>/^(https?:\/\/\S{1,500})?$/</Mask>
                <ValidationMessage>Vul een geldige http(s)-URL in, of laat leeg.</ValidationMessage>
            </gui_url>
            <filter_backend type="OptionField">
                <Default>none</Default>
                <Required>Y</Required>
                <OptionValues>
                    <none>Geen</none>
                    <adguard>AdGuard Home</adguard>
                </OptionValues>
            </filter_backend>
            <adguard_url type="TextField">
                <Mask>/^(https?:\/\/\S{1,300})?$/</Mask>
                <ValidationMessage>Vul een URL in zoals http://192.168.1.2:3000, of laat leeg.</ValidationMessage>
            </adguard_url>
            <adguard_user type="TextField">
                <Mask>/^.{0,128}$/</Mask>
            </adguard_user>
            <adguard_password type="TextField">
                <Mask>/^.{0,256}$/</Mask>
            </adguard_password>
            <adguard_verify_tls type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </adguard_verify_tls>
            <dns_group_mode type="OptionField">
                <Default>block</Default>
                <Required>Y</Required>
                <OptionValues>
                    <block>Blokkeren (aanbevolen bij profielen)</block>
                    <redirect>Omleiden naar de DNS-server</redirect>
                </OptionValues>
            </dns_group_mode>
        </general>
        <groups>
            <group type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[\p{L}0-9 _.\-]{1,64}$/u</Mask>
                    <ValidationMessage>Gebruik 1-64 tekens: letters, cijfers, spatie, punt, streepje of underscore.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>Deze groepsnaam bestaat al.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </name>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
                <profile type="ModelRelationField">
                    <Model>
                        <profiles>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>profiles.profile</items>
                            <display>name</display>
                        </profiles>
                    </Model>
                    <Required>N</Required>
                </profile>
            </group>
        </groups>
        <profiles>
            <profile type="ArrayField">
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[\p{L}0-9 _.\-]{1,64}$/u</Mask>
                    <ValidationMessage>Gebruik 1-64 tekens: letters, cijfers, spatie, punt, streepje of underscore.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>Deze profielnaam bestaat al.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </name>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
                <safesearch type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </safesearch>
                <parental type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </parental>
                <categories type="OptionField">
                    <Multiple>Y</Multiple>
                    <OptionValues>
                        <social>Sociale media</social>
                        <messaging>Chat en berichten</messaging>
                        <games>Games</games>
                        <video>Video en streaming</video>
                        <dating>Dating</dating>
                    </OptionValues>
                </categories>
                <blocked_domains type="TextField">
                    <Mask>/^([A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?(\s*,\s*[A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?)*)?$/</Mask>
                    <ValidationMessage>Vul domeinnamen in, gescheiden door komma's (bijvoorbeeld voorbeeld.nl, ander.com).</ValidationMessage>
                </blocked_domains>
                <allowed_domains type="TextField">
                    <Mask>/^([A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?(\s*,\s*[A-Za-z0-9]([A-Za-z0-9\-\.]{0,251}[A-Za-z0-9])?)*)?$/</Mask>
                    <ValidationMessage>Vul domeinnamen in, gescheiden door komma's (bijvoorbeeld voorbeeld.nl, ander.com).</ValidationMessage>
                </allowed_domains>
            </profile>
        </profiles>
        <devices>
            <device type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[\p{L}0-9 _.\-]{1,64}$/u</Mask>
                    <ValidationMessage>Gebruik 1-64 tekens: letters, cijfers, spatie, punt, streepje of underscore.</ValidationMessage>
                </name>
                <mac type="MacAddressField">
                    <Required>Y</Required>
                    <ValidationMessage>Vul een geldig MAC-adres in (aa:bb:cc:dd:ee:ff).</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>Dit MAC-adres zit al in een groep. Een apparaat kan maar in een groep zitten.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </mac>
                <group type="ModelRelationField">
                    <Model>
                        <groups>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>groups.group</items>
                            <display>name</display>
                        </groups>
                    </Model>
                    <Required>Y</Required>
                    <ValidationMessage>Kies een groep.</ValidationMessage>
                </group>
            </device>
        </devices>
        <bedtimes>
            <bedtime type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <groups type="ModelRelationField">
                    <Model>
                        <groups>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>groups.group</items>
                            <display>name</display>
                        </groups>
                    </Model>
                    <Multiple>Y</Multiple>
                    <Required>Y</Required>
                    <ValidationMessage>Kies minimaal een groep.</ValidationMessage>
                </groups>
                <days type="OptionField">
                    <Required>Y</Required>
                    <Multiple>Y</Multiple>
                    <OptionValues>
                        <mon>Maandag</mon>
                        <tue>Dinsdag</tue>
                        <wed>Woensdag</wed>
                        <thu>Donderdag</thu>
                        <fri>Vrijdag</fri>
                        <sat>Zaterdag</sat>
                        <sun>Zondag</sun>
                    </OptionValues>
                    <ValidationMessage>Kies minimaal een dag.</ValidationMessage>
                </days>
                <start type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([01][0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Gebruik het formaat UU:MM (24 uur).</ValidationMessage>
                </start>
                <end type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([01][0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                    <ValidationMessage>Gebruik het formaat UU:MM (24 uur).</ValidationMessage>
                </end>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
            </bedtime>
        </bedtimes>
        <budgets>
            <budget type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <groups type="ModelRelationField">
                    <Model>
                        <groups>
                            <source>OPNsense.ParentalControl.ParentalControl</source>
                            <items>groups.group</items>
                            <display>name</display>
                        </groups>
                    </Model>
                    <Multiple>Y</Multiple>
                    <Required>Y</Required>
                    <ValidationMessage>Kies minimaal een groep.</ValidationMessage>
                </groups>
                <days type="OptionField">
                    <Required>Y</Required>
                    <Multiple>Y</Multiple>
                    <OptionValues>
                        <mon>Maandag</mon>
                        <tue>Dinsdag</tue>
                        <wed>Woensdag</wed>
                        <thu>Donderdag</thu>
                        <fri>Vrijdag</fri>
                        <sat>Zaterdag</sat>
                        <sun>Zondag</sun>
                    </OptionValues>
                    <ValidationMessage>Kies minimaal een dag.</ValidationMessage>
                </days>
                <minutes type="IntegerField">
                    <Required>Y</Required>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1440</MaximumValue>
                    <ValidationMessage>Vul het aantal minuten in (0 tot 1440).</ValidationMessage>
                </minutes>
                <description type="TextField">
                    <Mask>/^.{0,255}$/u</Mask>
                </description>
            </budget>
        </budgets>
    </items>
</model>
