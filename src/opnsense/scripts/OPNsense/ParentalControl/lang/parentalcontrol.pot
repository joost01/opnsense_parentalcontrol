#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogGroup.xml
msgid "Optional. The profile is applied through the filter backend to all devices in this group."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "For example \"6-9 years\", \"10-12 years\" or \"13-15 years\"."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Enforce SafeSearch"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "AdGuard Home and Unbound: search engines (Google, Bing, DuckDuckGo, YouTube and others) are put in safe mode."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Adult content filter"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "AdGuard Home only: enables the parental control filter (adult websites)."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Block categories"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "AdGuard Home and Unbound: blocks well-known services in these categories."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Groups in the filter backend"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Pi-hole only: names of existing Pi-hole groups (comma separated) to which the devices of the group are added. Attach the blocklists (for example for adult content) to those groups in Pi-hole itself."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Extra blocked domains"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Comma separated. Subdomains are blocked as well."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Always allowed domains"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/dialogProfile.xml
msgid "Comma separated. Overrides blocks from the filter lists for this group."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Enable parental control. The firewall rules are reloaded when you apply the settings."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Check interval (seconds)"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "How often the daemon checks bedtimes and blocks or releases devices (5-60)."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Activity threshold (KB per minute)"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "A group counts as \"in use\" as soon as at least one device generates more traffic than this. Raise the value if idle devices still consume time."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Grace period (minutes)"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Short pauses without traffic (for example reading a page) still count if traffic resumes within this time. After that the counter stops."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Block page and requests"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Show block page"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Blocked devices see an explanation (HTTP traffic and DNS are redirected to the firewall). Without this option traffic is silently dropped. HTTPS sites show a connection error in the browser."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Block page port"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "The page only listens locally (127.0.0.1 and ::1) on this port. You do not need to open anything."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Allow requests for extra time"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Time between requests (minutes)"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "A group can make at most one request per period, also after a rejection."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "DNS filter (AdGuard Home, Pi-hole, ...)"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "DNS server(s)"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "IP address(es) of your DNS filter, for example AdGuard Home or Pi-hole (comma separated, at most 4; also enter the IPv6 address if it has one). Blocked devices may only use these servers for DNS. Leave empty to send DNS of blocked devices to Unbound on this firewall."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Enforce DNS"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "All DNS traffic (port 53, TCP and UDP) from clients on the selected interfaces is redirected to the first DNS server above, even when a device uses 8.8.8.8 or another server itself. The DNS server itself is excluded."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Interfaces with clients"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Select LAN-side interfaces only, never WAN. Otherwise your DNS server may become reachable from the internet."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Block encrypted DNS"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Blocks DNS-over-TLS (port 853) and HTTPS traffic to well-known public DNS resolvers from Google, Cloudflare, Quad9, OpenDNS and AdGuard (not exhaustive). The DNS server itself is excluded."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Website filter and SafeSearch"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml src/opnsense/mvc/app/views/OPNsense/ParentalControl/administration.volt src/opnsense/mvc/app/views/OPNsense/ParentalControl/overview.volt
msgid "Filter backend"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Used to apply website profiles per group. AdGuard Home supports SafeSearch, the adult content filter, categories and custom domains. Unbound (this firewall) supports SafeSearch, categories and custom domains without an external DNS filter. Pi-hole supports groups and custom domains. The plugin only manages its own items; nothing you configured yourself is changed."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Backend URL"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Address of the web interface of your DNS filter: AdGuard Home (for example http://192.168.1.2:3000) or Pi-hole (for example https://192.168.1.3). The API uses the same port. Not needed for Unbound."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Backend user"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "AdGuard Home only. Pi-hole only uses a password."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Backend password"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "AdGuard Home password, or a Pi-hole app password (Settings, Web interface/API). Stored in the OPNsense configuration; preferably use a dedicated user or app password for this plugin."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Verify TLS certificate"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Only relevant for an https URL. Disable for a self-signed certificate."
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Own DNS server for groups with a profile"
msgstr ""

#: src/opnsense/mvc/app/controllers/OPNsense/ParentalControl/forms/general.xml
msgid "Devices in a group with a profile that configure another DNS server (for example 8.8.8.8): blocking makes sure the profile cannot be bypassed. Redirecting sends the queries to the DNS server, but AdGuard may no longer recognise the device and will not apply the profile. Only works together with \"Enforce DNS\"."
msgstr ""

